#!/usr/bin/env bash
#
# generatesites — batch-create testlab WordPress sites from a JSON manifest
#
# Usage:
#   generatesites                  # reads ./sites.json next to this script
#   generatesites /path/to/other.json
#
# Manifest shape — a JSON array, one object per site:
#   [
#     {
#       "site": "wp1",                 required, lowercase letters/numbers only
#       "wp": "6.7",                   optional, default "latest"
#       "php": "8.1",                  optional, default "8.3"
#       "plugins": [ "path", ... ],    optional, dirs or .zip files, uploaded
#                                       and activated one at a time
#       "settings": [
#         { "option": "name", "path": ["key", "subkey"], "value": "..." }
#       ]                              optional, applied via
#                                       `wp option patch insert` after plugins
#     },
#     ...
#   ]
#
# Requires on PATH: newsite, siteshell (from /opt/testlab/bin), jq.
#
# Behavior: a failure at any step is logged and does NOT stop the run.
# generatesites moves on to the next step (or next site) and prints a
# pass/fail summary at the very end. Site creation itself uses `newsite`,
# which already rolls back its own partial state on failure.

set -uo pipefail   # deliberately no -e — see "Behavior" above

# -----------------------------------------------------------------------------
# Config
# -----------------------------------------------------------------------------
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_MANIFEST="$SELF_DIR/sites.json"
MANIFEST="${1:-$DEFAULT_MANIFEST}"

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
info() { echo "▶ $*"; }
ok()   { echo "✅ $*"; }
warn() { echo "⚠  $*" >&2; }
fail() { echo "❌ $*" >&2; }

command -v jq        >/dev/null 2>&1 || { fail "jq is required but not installed. Run: sudo apt install -y jq"; exit 1; }
command -v newsite    >/dev/null 2>&1 || { fail "'newsite' not found on PATH."; exit 1; }
command -v siteshell  >/dev/null 2>&1 || { fail "'siteshell' not found on PATH."; exit 1; }

[[ -r "$MANIFEST" ]] || { fail "Manifest not found or not readable: $MANIFEST"; exit 1; }
jq empty "$MANIFEST" 2>/dev/null || { fail "Manifest is not valid JSON: $MANIFEST"; exit 1; }

SITE_COUNT="$(jq 'length' "$MANIFEST")"
[[ "$SITE_COUNT" -gt 0 ]] 2>/dev/null || { fail "Manifest has no site entries: $MANIFEST"; exit 1; }

info "Loaded $SITE_COUNT site(s) from $MANIFEST"
echo ""

# Track results for the final summary. Runs in the current shell (process
# substitution, not a pipe) so this array survives across loop iterations.
declare -a SUMMARY=()

SITE_NUM=0
while IFS= read -r site_json; do
    SITE_NUM=$((SITE_NUM + 1))

    SITE="$(jq -r '.site // empty' <<<"$site_json")"
    WP="$(jq -r '.wp // "latest"' <<<"$site_json")"
    PHP="$(jq -r '.php // "8.3"' <<<"$site_json")"

    echo "============================================================"
    info "[$SITE_NUM/$SITE_COUNT] Site: ${SITE:-<missing name>}  (wp=$WP php=$PHP)"
    echo "============================================================"

    if [[ -z "$SITE" ]]; then
        fail "Entry #$SITE_NUM has no 'site' name — skipping."
        SUMMARY+=("SKIP  entry #$SITE_NUM — missing 'site' field")
        continue
    fi

    if [[ ! "$SITE" =~ ^[a-z0-9]+$ ]]; then
        fail "'$SITE' — invalid site name (lowercase letters/numbers only) — skipping."
        SUMMARY+=("FAIL  $SITE — invalid name")
        continue
    fi

    # -------------------------------------------------------------------
    # 1. Create the site
    # -------------------------------------------------------------------
    info "Creating site..."
    if ! newsite wordpress "$SITE" --wp "$WP" --php "$PHP"; then
        fail "$SITE — newsite failed, skipping plugins/settings for this site."
        SUMMARY+=("FAIL  $SITE — site creation failed")
        continue
    fi

    SITE_WARNINGS=0

    # -------------------------------------------------------------------
    # 2. Upload + activate plugins.
    #    siteshell only takes one --upload-plugin per call, and does not
    #    auto-activate — so each plugin gets an explicit upload + activate
    #    step. Activation slug = basename of the plugin path (matches how
    #    siteshell itself names the copied directory).
    # -------------------------------------------------------------------
    while IFS= read -r plugin_path; do
        [[ -z "$plugin_path" ]] && continue
        SLUG="$(basename "$plugin_path")"

        info "Uploading plugin: $SLUG"
        if ! siteshell "$SITE" --upload-plugin "$plugin_path"; then
            fail "$SITE — failed to upload plugin: $plugin_path"
            SITE_WARNINGS=$((SITE_WARNINGS + 1))
            continue
        fi

        info "Activating plugin: $SLUG"
        if ! siteshell "$SITE" --wpcli plugin activate "$SLUG"; then
            fail "$SITE — failed to activate plugin: $SLUG"
            SITE_WARNINGS=$((SITE_WARNINGS + 1))
        fi
    done < <(jq -r '.plugins[]?' <<<"$site_json")

    # -------------------------------------------------------------------
    # 3. Apply default settings.
    #    Originally this did per-key `wp option patch insert` calls, seeding
    #    each intermediate level with '{}' first. That turned out to be
    #    unsafe: re-running the '{}' seed against a level that already had
    #    sibling keys silently wiped them instead of failing as expected, so
    #    only the LAST setting in each nested group survived (e.g. only
    #    turnstile.secret_key remained, turnstile.site_key got wiped out
    #    when secret_key's seed step ran).
    #
    #    Fixed approach: merge every setting that shares the same option
    #    name into one full nested JSON object (via jq's `setpath`), then
    #    write it with a single `wp option update` per option. `update`
    #    auto-creates the row if it doesn't exist yet (unlike `add`), so no
    #    separate seeding step is needed at all, and there's no ordering
    #    hazard since each option is written exactly once, fully formed.
    # -------------------------------------------------------------------
    while IFS= read -r merged_json; do
        [[ -z "$merged_json" ]] && continue
        OPTION="$(jq -r '.option' <<<"$merged_json")"
        MERGED_VALUE="$(jq -c '.merged' <<<"$merged_json")"
        MERGED_KEYS="$(jq -c '.merged | keys' <<<"$merged_json")"

        info "Setting $OPTION $MERGED_KEYS"
        if ! siteshell "$SITE" --wpcli option update "$OPTION" "$MERGED_VALUE" --format=json; then
            fail "$SITE — failed to update $OPTION"
            SITE_WARNINGS=$((SITE_WARNINGS + 1))
        fi
    done < <(jq -c '
        (.settings // [])
        | group_by(.option)
        | map({option: .[0].option, merged: (reduce .[] as $s ({}; setpath($s.path; $s.value)))})
        | .[]
    ' <<<"$site_json")

    if [[ "$SITE_WARNINGS" -eq 0 ]]; then
        ok "$SITE — done, no issues"
        SUMMARY+=("OK    $SITE")
    else
        warn "$SITE — created, but $SITE_WARNINGS plugin/setting step(s) failed (see above)"
        SUMMARY+=("WARN  $SITE — $SITE_WARNINGS step(s) failed")
    fi
    echo ""

done < <(jq -c '.[]' "$MANIFEST")

# -----------------------------------------------------------------------------
# Summary
# -----------------------------------------------------------------------------
echo "============================================================"
echo "Summary"
echo "============================================================"
for line in "${SUMMARY[@]}"; do
    echo "  $line"
done
echo ""
