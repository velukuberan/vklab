#!/usr/bin/env bash
#
# newsite — spin up a new site from a template
# Usage: newsite <template> <name> [flags]
#
# Flags (all optional):
#   --wp <version>        WordPress version (default: latest)
#   --php <version>       PHP version (default: 8.3)
#   --mariadb <version>   MariaDB version (default: 11)
#   --admin-user <name>   WP admin username (default: admin)
#   --admin-pass <pass>   WP admin password (default: random 16 chars)
#   --admin-email <email> WP admin email (default: admin@test.vkuberan.in)
#   --title <string>      WP site title (default: same as site name)
#
# Example:
#   newsite wordpress wp1
#   newsite wordpress wp2 --wp 6.7 --php 8.3
#   newsite wordpress oldstack --wp 6.4 --php 8.1

set -euo pipefail

# -----------------------------------------------------------------------------
# Config
# -----------------------------------------------------------------------------
TESTLAB="/opt/testlab"
TEMPLATES="$TESTLAB/templates"
SITES="$TESTLAB/sites"
BASE_DOMAIN="test.vkuberan.in"
MAIL_URL="https://mail.${BASE_DOMAIN}"
SITES_LOG="$TESTLAB/sites.log"

# Defaults
WP_VERSION="latest"
PHP_VERSION="8.3"
MARIADB_VERSION="11"
ADMIN_USER="admin"
ADMIN_PASS=""
ADMIN_EMAIL="admin@test.vkuberan.in"
SITE_TITLE=""

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
die() { echo "❌ $*" >&2; exit 1; }
info() { echo "▶ $*"; }
ok() { echo "✅ $*"; }

# Random string of N chars (letters + digits, no ambiguous chars)
randstr() {
    local len="$1"
    local raw
    raw="$(LC_ALL=C tr -dc 'A-HJ-NP-Za-km-z2-9' < /dev/urandom 2>/dev/null | head -c "$len" || true)"
    printf '%s' "$raw"
}

# -----------------------------------------------------------------------------
# Parse positional arguments
# -----------------------------------------------------------------------------
[[ $# -ge 2 ]] || die "Usage: newsite <template> <name> [flags]
Example: newsite wordpress wp1 --wp 6.7 --php 8.3"

TEMPLATE="$1"
SITE="$2"
shift 2

# -----------------------------------------------------------------------------
# Parse flags
# -----------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --wp)           WP_VERSION="$2"; shift 2 ;;
        --php)          PHP_VERSION="$2"; shift 2 ;;
        --mariadb)      MARIADB_VERSION="$2"; shift 2 ;;
        --admin-user)   ADMIN_USER="$2"; shift 2 ;;
        --admin-pass)   ADMIN_PASS="$2"; shift 2 ;;
        --admin-email)  ADMIN_EMAIL="$2"; shift 2 ;;
        --title)        SITE_TITLE="$2"; shift 2 ;;
        *)              die "Unknown flag: $1" ;;
    esac
done

# Apply title default (after parsing, since it depends on SITE)
[[ -z "$SITE_TITLE" ]] && SITE_TITLE="$SITE"

# Generate admin password if not given
[[ -z "$ADMIN_PASS" ]] && ADMIN_PASS="$(randstr 16)"

# -----------------------------------------------------------------------------
# Validation
# -----------------------------------------------------------------------------
TEMPLATE_DIR="$TEMPLATES/$TEMPLATE"
[[ -d "$TEMPLATE_DIR" ]] || die "Template '$TEMPLATE' not found in $TEMPLATES"

[[ "$SITE" =~ ^[a-z0-9]+$ ]] || die "Site name must be lowercase letters and numbers only (got: $SITE)"

SITE_DIR="$SITES/$SITE"
[[ ! -d "$SITE_DIR" ]] || die "Site '$SITE' already exists at $SITE_DIR"

# -----------------------------------------------------------------------------
# Rollback on error — clean up half-created site
# -----------------------------------------------------------------------------
CLEANUP_ENABLED=true
cleanup_on_error() {
    local exit_code=$?
    if $CLEANUP_ENABLED && [[ $exit_code -ne 0 ]] && [[ -d "$SITE_DIR" ]]; then
        echo ""
        echo "⚠  newsite failed. Cleaning up partial state..."
        cd "$SITE_DIR" 2>/dev/null && docker compose down -v --remove-orphans 2>/dev/null || true
        cd /
        rm -rf "$SITE_DIR"
        echo "   Removed partial site directory: $SITE_DIR"
    fi
}
trap cleanup_on_error EXIT

# -----------------------------------------------------------------------------
# Create site folder from template
# -----------------------------------------------------------------------------
info "Creating site '$SITE' from template '$TEMPLATE'..."
mkdir -p "$SITE_DIR"
cp "$TEMPLATE_DIR/docker-compose.yml.tmpl" "$SITE_DIR/docker-compose.yml"
cp "$TEMPLATE_DIR/.env.tmpl" "$SITE_DIR/.env"

# -----------------------------------------------------------------------------
# Generate DB passwords
# -----------------------------------------------------------------------------
DB_PASSWORD="$(randstr 24)"
DB_ROOT_PASSWORD="$(randstr 24)"

# -----------------------------------------------------------------------------
# Substitute placeholders
# -----------------------------------------------------------------------------
sed -i "s|__SITE__|$SITE|g" "$SITE_DIR/docker-compose.yml"

sed -i \
    -e "s|__SITE__|$SITE|g" \
    -e "s|__WP_VERSION__|$WP_VERSION|g" \
    -e "s|__PHP_VERSION__|$PHP_VERSION|g" \
    -e "s|__MARIADB_VERSION__|$MARIADB_VERSION|g" \
    -e "s|__DB_PASSWORD__|$DB_PASSWORD|g" \
    -e "s|__DB_ROOT_PASSWORD__|$DB_ROOT_PASSWORD|g" \
    -e "s|__ADMIN_USER__|$ADMIN_USER|g" \
    -e "s|__ADMIN_PASS__|$ADMIN_PASS|g" \
    -e "s|__ADMIN_EMAIL__|$ADMIN_EMAIL|g" \
    -e "s|__SITE_TITLE__|$SITE_TITLE|g" \
    "$SITE_DIR/.env"

# -----------------------------------------------------------------------------
# Compute the correct WordPress image tag
# Docker Hub's wordpress tag scheme:
#   latest → wordpress:php<PHP>-apache  (no "latest" prefix allowed)
#   6.7    → wordpress:6.7-php<PHP>-apache
# -----------------------------------------------------------------------------
if [[ "$WP_VERSION" == "latest" ]]; then
    WP_IMAGE_TAG="php${PHP_VERSION}-apache"
else
    WP_IMAGE_TAG="${WP_VERSION}-php${PHP_VERSION}-apache"
fi

echo "WP_IMAGE_TAG=$WP_IMAGE_TAG" >> "$SITE_DIR/.env"
chmod 600 "$SITE_DIR/.env"

# -----------------------------------------------------------------------------
# Bring up the containers
# -----------------------------------------------------------------------------
info "Pulling images and starting containers (may take a minute on first run)..."
cd "$SITE_DIR"
docker compose up -d

# -----------------------------------------------------------------------------
# Wait for WordPress to respond
#
# Why --resolve? Docker's NAT does not permit a container to reach the host's
# own public IP via loopback (hairpin NAT). curl from the droplet to the site's
# public URL would hang. --resolve routes curl straight to Traefik on 127.0.0.1
# instead. Without this, the wait loop hangs on every restore regardless of
# DNS or cert state. Do not remove.
# -----------------------------------------------------------------------------
URL="https://${SITE}.${BASE_DOMAIN}"
info "Waiting for $URL to respond..."

WAIT_INTERVAL=2
WAIT_MAX_ATTEMPTS=60
WAIT_TIMEOUT=$((WAIT_INTERVAL * WAIT_MAX_ATTEMPTS))

WP_READY=false
for _ in $(seq 1 "$WAIT_MAX_ATTEMPTS"); do
    if curl -sfk -o /dev/null -w '%{http_code}' \
        --resolve "${SITE}.${BASE_DOMAIN}:443:127.0.0.1" \
        "$URL" | grep -qE '^(200|301|302)$'; then
        WP_READY=true
        break
    fi
    sleep "$WAIT_INTERVAL"
done

if ! $WP_READY; then
    die "Containers are up but $URL didn't respond within ${WAIT_TIMEOUT}s. Check logs with: docker logs ${SITE}-wp"
fi

# -----------------------------------------------------------------------------
# WP-CLI helper — runs wp-cli container against this site
# Uses UID 33 (www-data) so it has write access to /var/www/html
# HOME=/tmp so WP-CLI has a writable cache directory
# -----------------------------------------------------------------------------
wpcli() {
    docker run --rm \
        --network "${SITE}_internal" \
        --volumes-from "${SITE}-wp" \
        --user "33:33" \
        -e HOME=/tmp \
        -e WORDPRESS_DB_HOST=db:3306 \
        -e WORDPRESS_DB_NAME=wordpress \
        -e WORDPRESS_DB_USER=wordpress \
        -e WORDPRESS_DB_PASSWORD="$DB_PASSWORD" \
        "wordpress:cli-php${PHP_VERSION}" \
        "$@"
}

# -----------------------------------------------------------------------------
# Install WordPress non-interactively
# -----------------------------------------------------------------------------
info "Installing WordPress via WP-CLI..."
wpcli wp core install \
    --url="$URL" \
    --title="$SITE_TITLE" \
    --admin_user="$ADMIN_USER" \
    --admin_password="$ADMIN_PASS" \
    --admin_email="$ADMIN_EMAIL" \
    --skip-email > /dev/null

# -----------------------------------------------------------------------------
# Install and configure WP Mail SMTP plugin → mailpit
# WP-CLI writes plugin config to DB. Actual mail sending happens later from
# the WP container, which is on the `web` network alongside mailpit.
# -----------------------------------------------------------------------------
info "Installing WP Mail SMTP plugin and pointing it at mailpit..."
wpcli wp plugin install wp-mail-smtp --activate --quiet

SMTP_CONFIG=$(cat <<JSON
{
    "mail": {
        "from_email": "${SITE}@test.vkuberan.in",
        "from_name": "${SITE_TITLE} (testlab)",
        "mailer": "smtp",
        "return_path": false,
        "from_email_force": true,
        "from_name_force": true
    },
    "smtp": {
        "host": "mailpit",
        "port": 1025,
        "encryption": "none",
        "autotls": false,
        "auth": false,
        "user": "",
        "pass": ""
    }
}
JSON
)

wpcli wp option update wp_mail_smtp "$SMTP_CONFIG" --format=json > /dev/null

# -----------------------------------------------------------------------------
# Save credentials file (for siteinfo)
# -----------------------------------------------------------------------------
cat > "$SITE_DIR/.credentials" << CREDS
SITE_NAME=$SITE
SITE_URL=$URL
ADMIN_URL=$URL/wp-admin/
ADMIN_USER=$ADMIN_USER
ADMIN_PASS=$ADMIN_PASS
ADMIN_EMAIL=$ADMIN_EMAIL
CREATED_AT=$(date '+%Y-%m-%d %H:%M:%S')
CREDS
chmod 600 "$SITE_DIR/.credentials"

# -----------------------------------------------------------------------------
# Append to sites log
# -----------------------------------------------------------------------------
echo "$(date '+%Y-%m-%d %H:%M:%S')  CREATE  $SITE  $TEMPLATE  wp=$WP_VERSION php=$PHP_VERSION mariadb=$MARIADB_VERSION" >> "$SITES_LOG"

# All done — disable rollback trap
CLEANUP_ENABLED=false

# -----------------------------------------------------------------------------
# Success summary
# -----------------------------------------------------------------------------
echo ""
ok "$SITE is live at $URL"
echo ""
echo "   Stack:       WordPress $WP_VERSION · PHP $PHP_VERSION · MariaDB $MARIADB_VERSION"
echo ""
echo "   🔐 Admin login"
echo "      URL:      $URL/wp-admin/"
echo "      Username: $ADMIN_USER"
echo "      Password: $ADMIN_PASS"
echo ""
echo "   📬 Test emails"
echo "      All mail from this site lands in mailpit:"
echo "      $MAIL_URL"
echo ""
echo "   📂 Location"
echo "      Site dir:   $SITE_DIR"
echo "      Containers: ${SITE}-wp, ${SITE}-db"
echo ""
echo "   💡 Retrieve credentials later: siteinfo $SITE"
echo ""
