# Traefik dynamic config — dashboard basic-auth + default TLS store
# Generate the bcrypt hash with:
#   htpasswd -nbB admin 'your-strong-password'
# Then paste the full "user:hash" line below
# In this file, single $ is correct (unlike docker-compose labels which need $$)

http:
  middlewares:
    dashboard-auth:
      basicAuth:
        users:
          - "admin:REPLACE_WITH_BCRYPT_HASH"

# Default TLS store: every router with `tls=true` (and no explicit certresolver)
# will be served this wildcard cert. One cert covers *.test.vkuberan.in, so
# spinning up new sites doesn't trigger new ACME challenges.
tls:
  stores:
    default:
      defaultGeneratedCert:
        resolver: dnsresolver
        domain:
          main: test.vkuberan.in
          sans:
            - "*.test.vkuberan.in"
